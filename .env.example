PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Security and browser access. In production, use your deployed site URL, for example:
# CLIENT_ORIGIN=https://www.your-domain.ca
CLIENT_ORIGIN=http://localhost:5173
# Set to true on Render so request IP-based protections work behind its proxy.
TRUST_PROXY=false

# Used only by npm run seed:admin
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword

# Optional email delivery for the Contact Us form. Create these at deployment time,
# never commit the real values. Without them, messages remain in the admin inbox.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=LifeReady Training <contact@your-verified-domain.example>
# Optional override; otherwise the first administrator account receives the email.
CONTACT_ADMIN_EMAIL=admin@example.com
