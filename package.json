{
  "dependencies": {
    "@cypress/chrome-recorder": "^2.3.1",
    "compression": "^1.8.1",
    "concurrently": "^10.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
